{
    "name": "yireo/magento2-catalog-utils",
    "type": "magento2-module",
    "version": "1.1.0",
    "license": "OSL-3.0",
    "description": "Generic module containing Magento 2 catalog utilites for other modules",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "magento/framework": "^101.0|^102.0|^103.0",
        "magento/module-catalog": "^101.0|^102.0|^103.0|^104.0",
        "magento/module-eav": "^100.0|^101.0|^102.0",
        "magento/module-store": "^100.0|^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.5",
        "yireo/magento2-integration-test-helper": "~0.0.23"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\CatalogUtils\\": ""
        },
        "files": [
            "registration.php"
        ]
    }
}